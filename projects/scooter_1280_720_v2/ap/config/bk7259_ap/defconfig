# Main/init task runs beken_ui_init()->lv_image_set_src("S:/home_bg.jpg"), whose
# LVGL TJPGD decoder_info puts a 4KB work buffer + JDEC on the stack. The 4096B
# default overflows (UsageFault). Bump to give headroom for JPEG header probe.
CONFIG_APP_MAIN_TASK_STACK_SIZE=12288

# Full BT + Wi-Fi + LVGL + dashcam ISP initialization consumes more than the
# default 160 dynamic spinlocks (FreeRTOS queues/semaphores/mutexes each hold one).
CONFIG_SPINLOCK_DYNAMIC_CNT=256

