# Sized between the SDK default 0x20000 (128KB) and the too-small 0x8000 (32KB).
# vg_lite_init() carves its heap FROM this contiguous buffer and needs, per
# vg_lite_kernel.c init_vglite(): 2x command_buffer (~8KB each = 16KB) PLUS a
# mandatory 32KB power/backup command context (power_context_capacity = 32<<10),
# i.e. ~48KB minimum. 0x8000 (32KB) only fits the 2 command buffers and then OOMs
# on the power context (init_vglite:459) -> vg_lite_init fails but leaves
# s_context.rtbuffer set, so every later vg_lite_init() short-circuits with
# "already initialized" WITHOUT binding command_buffer[] -> set_render_target
# spams VG_LITE_NO_CONTEXT and the assist view shows nothing. That OOM first
# fires at boot from boot_avi's GPU splash path (jsp/bk_gpu_init).
# Budget at assist-view entry (measured): ~114KB free HSRAM must hold THREE
# separate HSRAM allocations from gpu_ctlr_open():
#   1) vg_lite contiguous heap  = this value
#   2) pingpong output buffers  = ~40KB (bk_get_gpu_output_buffer)
#   3) GPU flexa worker stack    = 10KB (rtos_create_hsram_thread, 1024*10)
# 0x10000 (64KB) let vg_lite + pingpong fit but left only ~10KB, so the 10KB
# worker stack alloc failed (gpu_ctlr_open:1387 rtos_create_hsram_thread failed).
# 0xD000 (52KB) keeps vg_lite safely above its ~48.2KB need (2x8KB cmd + 32KB
# power context) while dropping the total to 52+40+10 = ~102KB, leaving ~12KB
# headroom for the worker stack + heap overhead. 128KB starves pingpong; 32KB
# OOMs vg_lite's power context (see boot_avi splash path).
# NOTE: 0x20000 (128KB, SoC default) was A/B tested on 2026-07-14 and did NOT
# fix the boot_avi JPEG decode failure (every frame still status=0x00010500),
# so this heap size is NOT the cause of that failure. Kept at 0xD000 (52KB)
# which is the size the assist-view HSRAM budget (vg_lite + pingpong + worker
# stack) needs; see the assist-view budget analysis below.
CONFIG_VG_LITE_GPU_CONTIGUOUS_MEM_SZ=0xD000
